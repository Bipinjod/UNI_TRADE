!src/main/webapp/assets/uploads/.gitkeep

src/main/webapp/assets/uploads/items/*
!src/main/webapp/assets/uploads/items/.gitkeep

src/main/webapp/assets/uploads/profiles/*
!src/main/webapp/assets/uploads/profiles/.gitkeep

